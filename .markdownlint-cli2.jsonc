{
  "globs": [
    "**/*.md"
  ],
  "ignores": [
    ".venv",
    "node_modules",
    "target"
  ],
  "gitignore": true,
  "config": {
    "default": true,
    "MD004": false,
    "MD005": false,
    "MD006": false,
    "MD007": false,
    "MD013": false,
    "MD024": {
      "siblings_only": true
    },
    "MD029": false,
    "MD030": false,
    "MD032": false,
    "MD033": false
  }
}
